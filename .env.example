# Postgres connection used by the app (on Supabase: the pooled "Transaction" URL, port 6543, add ?pgbouncer=true)
DATABASE_URL="postgresql://restro:restro@localhost:5432/restro"
# Direct connection used for migrations (on Supabase: the "Session"/direct URL, port 5432)
DIRECT_URL="postgresql://restro:restro@localhost:5432/restro"
# Long random string used to sign staff login sessions. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
