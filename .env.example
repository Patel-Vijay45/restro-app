# Postgres connection used by the app
DATABASE_URL="postgresql://restro:restro@localhost:5432/restro"
# Connection used for migrations (same as above unless your host gives a separate "direct" URL)
DIRECT_URL="postgresql://restro:restro@localhost:5432/restro"
# Long random string used to sign staff login sessions. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
# Optional: public web address used inside table QR codes, e.g. https://dfc.example.in
