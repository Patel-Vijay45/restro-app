// DFC Family Restaurant system.
// Money is stored as integer paise (₹1 = 100) to avoid rounding errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OutletType {
  RESTAURANT // table service: waiters, tables, kitchen screen
  COUNTER // counter service: pay first, token number (mall stall)
}

enum Role {
  OWNER // everything, every outlet
  MANAGER // everything in their outlet
  CASHIER // billing and payments
  WAITER // take table orders
  KITCHEN // kitchen screen only
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  COUNTER
}

enum OrderChannel {
  STAFF // entered by staff (or a table QR request they accepted)
  ONLINE // takeaway ordered on the website
}

enum OrderStatus {
  OPEN // items being ordered / eaten
  BILLED // bill generated, waiting for payment
  PAID
  CANCELLED
}

enum KotStatus {
  NEW
  PREPARING
  READY
  SERVED
}

enum RequestKind {
  CALL_WAITER
  BILL
  ORDER // customer picked dishes on the table QR; a waiter confirms before it goes to the kitchen
}

enum RequestStatus {
  PENDING
  DONE
  REJECTED
}

enum IngredientUnit {
  KG // stock in kg, recipes in grams
  LITRE // stock in litres, recipes in ml
  PIECE // stock and recipes in pieces
}

enum StockMoveType {
  PURCHASE
  SALE // used by an order sent to the kitchen (from the dish recipe)
  CANCEL_RETURN // item removed before cooking started: stock goes back
  WASTAGE
  COUNT_ADJUST // physical count differed from the system
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

model Outlet {
  id            String     @id @default(cuid())
  name          String
  type          OutletType
  address       String     @default("")
  phone         String     @default("")
  upiId         String     @default("") // shown as a QR code on bills
  billFooter    String     @default("Thank you! Visit again.")
  paperWidth    Int        @default(80) // receipt printer paper, 58 or 80 mm
  gstEnabled    Boolean    @default(false)
  gstin         String     @default("")
  gstRateBp     Int        @default(500) // basis points: 500 = 5%
  // shown on the public website
  tagline       String     @default("")
  hours         String     @default("") // e.g. "Every day, 11 AM – 11 PM"
  mapsUrl       String     @default("") // Google Maps link for "Directions"
  showOnWebsite Boolean    @default(true)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())

  staff       Staff[]
  tables      DiningTable[]
  categories  Category[]
  menuItems   MenuItem[]
  orders      Order[]
  kots        Kot[]
  counters    Counter[]
  requests    CustomerRequest[]
  ingredients Ingredient[]
  stockMoves  StockMove[]
}

model Staff {
  id          String    @id @default(cuid())
  name        String
  role        Role
  pinHash     String
  // null means the person can work at every outlet (owner)
  outletId    String?
  outlet      Outlet?   @relation(fields: [outletId], references: [id])
  active      Boolean   @default(true)
  // wrong-PIN protection: locked for a few minutes after repeated mistakes
  failedPins  Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  requestsHandled CustomerRequest[]
  stockMoves      StockMove[]
  ordersCreated   Order[]           @relation("OrderCreatedBy")
  kotsCreated     Kot[]             @relation("KotCreatedBy")
  payments        Payment[]
}

model DiningTable {
  id        String  @id @default(cuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id])
  name      String
  seats     Int     @default(4)
  sortOrder Int     @default(0)
  // secret used in the table's QR code link (customer view, phase 3)
  qrToken   String  @unique @default(cuid())
  active    Boolean @default(true)

  orders   Order[]
  requests CustomerRequest[]

  @@unique([outletId, name])
}

model Category {
  id        String     @id @default(cuid())
  outletId  String
  outlet    Outlet     @relation(fields: [outletId], references: [id])
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  items     MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String   @default("")
  price       Int // paise
  isVeg       Boolean
  isAvailable Boolean  @default(true) // "sold out today" switch
  sortOrder   Int      @default(0)
  active      Boolean  @default(true) // false = removed from menu
  createdAt   DateTime @default(now())

  photoId    String?      @unique
  photo      Photo?       @relation(fields: [photoId], references: [id])
  orderItems OrderItem[]
  recipe     RecipeLine[]
}

// Dish photo (resized on the phone before upload, about 50–200 KB). Served from /photo/<id>.
model Photo {
  id        String    @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime  @default(now())
  menuItem  MenuItem?
}

model Order {
  id            String       @id @default(cuid())
  outletId      String
  outlet        Outlet       @relation(fields: [outletId], references: [id])
  type          OrderType
  status        OrderStatus  @default(OPEN)
  tableId       String?
  table         DiningTable? @relation(fields: [tableId], references: [id])
  tokenNo       Int? // counter orders: number called out when food is ready
  billNo        Int? // set when the bill is generated
  guests        Int?
  customerName  String       @default("")
  customerPhone String       @default("")
  channel       OrderChannel @default(STAFF)
  // website orders: key of the customer's tracking page
  trackToken    String?      @unique
  pickupTime    String       @default("")
  createdById   String
  createdBy     Staff        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  // filled when the bill is generated (paise)
  subtotal     Int    @default(0)
  discount     Int    @default(0)
  discountNote String @default("")
  tax          Int    @default(0)
  roundOff     Int    @default(0)
  total        Int    @default(0)

  cancelReason String    @default("")
  createdAt    DateTime  @default(now())
  billedAt     DateTime?
  paidAt       DateTime?

  items    OrderItem[]
  kots     Kot[]
  payments Payment[]
  requests CustomerRequest[]

  @@index([outletId, status])
  @@index([outletId, createdAt])
}

// Kitchen order ticket: one batch of items sent to the kitchen together.
model Kot {
  id          String    @id @default(cuid())
  outletId    String
  outlet      Outlet    @relation(fields: [outletId], references: [id])
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  number      Int // resets every day
  status      KotStatus @default(NEW)
  createdById String
  createdBy   Staff     @relation("KotCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items   OrderItem[]
  request CustomerRequest?

  @@index([outletId, status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  kotId        String
  kot          Kot      @relation(fields: [kotId], references: [id])
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  // copied at order time so later menu edits don't change old bills
  name         String
  price        Int
  isVeg        Boolean
  qty          Int
  note         String   @default("")
  cancelled    Boolean  @default(false)
  cancelReason String   @default("")
  createdAt    DateTime @default(now())
}

model Payment {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id])
  mode         PaymentMode
  amount       Int
  receivedById String
  receivedBy   Staff       @relation(fields: [receivedById], references: [id])
  createdAt    DateTime    @default(now())
}

// Running numbers per outlet: bill numbers (never reset), KOT and token numbers (reset daily).
model Counter {
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])
  key      String // "bill" | "kot" | "token"
  day      String // "YYYY-MM-DD" (India time) or "all"
  value    Int    @default(0)

  @@id([outletId, key, day])
}

// Something a customer asked for: from a table QR (tableId set) or a website takeaway order (trackToken set).
// ORDER requests become a kitchen ticket (KOT) only when staff accept them.
model CustomerRequest {
  id            String        @id @default(cuid())
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id])
  tableId       String?
  table         DiningTable?  @relation(fields: [tableId], references: [id])
  kind          RequestKind
  status        RequestStatus @default(PENDING)
  // ORDER only: [{ menuItemId, qty, note }]
  items         Json?
  // website orders: groups all rounds of one customer order, and is the key of the tracking page
  trackToken    String?
  customerName  String        @default("")
  customerPhone String        @default("")
  pickupTime    String        @default("")
  rejectReason  String        @default("")
  // filled when an ORDER request is accepted
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  kotId         String?       @unique
  kot           Kot?          @relation(fields: [kotId], references: [id])
  handledById   String?
  handledBy     Staff?        @relation(fields: [handledById], references: [id])
  handledAt     DateTime?
  createdAt     DateTime      @default(now())

  @@index([outletId, status])
  @@index([tableId, createdAt])
  @@index([trackToken])
  @@map("TableRequest")
}

// ---------- Inventory ----------
// Quantities are integers in thousandths of the unit ("milli"): 1 kg = 1000, 250 g = 250, 1 piece = 1000.

model Ingredient {
  id          String         @id @default(cuid())
  outletId    String
  outlet      Outlet         @relation(fields: [outletId], references: [id])
  name        String
  unit        IngredientUnit
  stock       Int            @default(0) // milli; can go below zero if recipes use more than was recorded
  lowStock    Int            @default(0) // milli; alert at or below this
  costPerUnit Int            @default(0) // paise per kg / litre / piece (average of purchases)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  recipeLines RecipeLine[]
  moves       StockMove[]

  @@unique([outletId, name])
}

// How much of an ingredient one portion of a dish uses.
model RecipeLine {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  qty          Int // milli

  @@unique([menuItemId, ingredientId])
}

// Every change to stock, so the history can always be checked.
model StockMove {
  id           String        @id @default(cuid())
  outletId     String
  outlet       Outlet        @relation(fields: [outletId], references: [id])
  ingredientId String
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])
  type         StockMoveType
  qty          Int // milli, + adds stock, - removes it
  value        Int           @default(0) // paise: amount paid for purchases, estimated cost for the rest
  supplier     String        @default("")
  note         String        @default("")
  orderItemId  String?
  staffId      String?
  staff        Staff?        @relation(fields: [staffId], references: [id])
  createdAt    DateTime      @default(now())

  @@index([ingredientId, createdAt])
  @@index([outletId, type, createdAt])
  @@index([orderItemId])
}
